@model WordStation.WebUI.Models.HomeViewModel

<div id="tableView" class="d-none">
    <div class="card border-0 bg-transparent">
        <div class="table-responsive">
            <table class="table table-dark table-striped table-borderless mb-0">
                <thead>
                    <tr>
                        <th style="width: 5%;" class="text-center">#</th>
                        <th style="width: 25%;">ENGLISH</th>
                        <th style="width: 25%;">TURKISH</th>
                        <th style="width: 40%;">EXAMPLE SENTENCE</th>
                        <th style="width: 5%;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Words != null && Model.Words.Any())
                    {
                        int index = 1;
                        foreach (var word in Model.Words)
                        {
                            <tr id="word-row-@word.Id" class="word-row">
                                <td class="text-center fw-bold align-middle">@index</td>
                                <td class="align-middle"><strong>@word.En</strong></td>
                                <td class="align-middle">@word.Tr</td>
                                <td class="align-middle">
                                    @if (!string.IsNullOrEmpty(word.Example))
                                    {
                                        <em class="text-white-50" style="white-space: pre-wrap;">@word.Example</em>
                                    }
                                    else
                                    {
                                        <span class="text-white-50">-</span>
                                    }
                                </td>
                                <td class="text-nowrap align-middle">
                                    <div class="dropdown">
                                        <button type="button"
                                                class="btn btn-link text-white text-decoration-none p-1"
                                                data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#updateWordModal"
                                                        data-id="@word.Id"
                                                        data-en="@word.En"
                                                        data-tr="@word.Tr"
                                                        data-example="@(word.Example ?? "")"
                                                        data-listname="@word.ListName">
                                                    <i class="bi bi-pencil-fill me-2"></i>Update
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item text-danger"
                                                        onclick="deleteWord(@word.Id, '@Model.SelectedList', '@word.En', '@Model.SearchTerm', '@Model.SearchMode')">
                                                    <i class="bi bi-trash-fill me-2"></i>Delete
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-white-50">
                                No words found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
