@model WordStation.WebUI.Models.HomeViewModel

@{
    ViewData["Title"] = $"{Model.SelectedList} List";
}

@section Styles {
    <style>
        /* ===== CSS VARIABLES (Shared) ===== */
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
            --banner-bg: rgba(255, 255, 255, 0.045);
            --banner-border-hover: rgba(0, 220, 255, 0.40);
            /* Tüm bölümler arası eşit boşluk — responsive */
            --section-gap: clamp(10px, 1.5vw, 16px);
            --navbar-h: 56px; /* JS tarafından dinamik olarak güncellenir */
        }

        /* ===== TOP BAR (Sticky Search) ===== */
        .top-bar-fixed {
            position: sticky;
            top: 0;
            z-index: 1050;
            background-color: rgba(13, 13, 20, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding-top: calc(var(--section-gap) * 2);
            padding-bottom: calc(var(--section-gap) * 2);
            border-bottom: none;
            margin-bottom: 0;
        }

        .top-bar-fixed .dropdown-menu {
            z-index: 1051;
        }


        /* ===== BANNER ===== */
        .banner-shell {
            position: relative;
            border-radius: 14px;
            padding: 1px;
            background: linear-gradient(140deg, rgba(0, 220, 255, 0.25), rgba(140, 92, 255, 0.15) 40%, rgba(255, 255, 255, 0.04) 70%);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            margin-bottom: 0;
            /* Margin handled by top-bar-fixed */
            transition: transform 0.2s ease;
        }

        .banner-card {
            background: var(--banner-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid transparent;
            border-radius: 13px;
            padding: 8px 12px;
            /* Padding biraz kısıldı */
        }

        .banner-shell:hover .banner-card {
            border-color: var(--banner-border-hover);
        }

        .modern-input {
            height: 38px;
            /* Butonlarla eşitlendi */
            background: var(--glass-bg);
            border: 1.5px solid var(--glass-border);
            color: #fff;
            border-radius: 10px !important;
            padding: 0 14px;
            font-size: 0.9rem;
        }

        .modern-input:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 220, 255, 0.6);
            box-shadow: none;
            /* Focus shadow kaldırıldı, temiz görünüm */
            color: #fff;
            outline: none;
        }

        /* Input group içindeki border fix */
        .input-group .btn {
            border: 1.5px solid var(--glass-border);
            border-right: none;
            height: 38px;
            z-index: 2;
        }

        .input-group .form-control {
            z-index: 1;
        }

        .input-group .form-control:focus {
            z-index: 3;
            border-color: rgba(0, 220, 255, 0.6);
        }

        .banner-btn {
            height: 38px;
            min-width: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px !important;
            padding: 0 14px;
            border: 1.5px solid var(--glass-border);
            transition: all 0.2s ease;
        }

        .banner-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-1px);
        }

        .banner-btn.btn-success {
            background: linear-gradient(135deg, #0d9488 0%, #10b981 100%);
            border: none;
            box-shadow: 0 4px 15px rgba(13, 148, 136, 0.3);
        }

        .banner-btn.btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
        }

        /* ===== MOBILE TWEAKS ===== */
        /* ===== MOBILE TWEAKS (Max 768px - Tablet & Medium) ===== */
        @@media (max-width: 768px) {

            /* Form genişliğini ayarlayıp çok fazla ezilmesini engelle */
            .banner-card form {
                flex-grow: 1;
                min-width: 200px !important;
            }
        }

        /* ===== MOBILE TWEAKS (Max 576px) ===== */
        @@media (max-width: 576px) {
            .banner-shell {
                margin-bottom: 8px !important;
            }

            /* Tek satır yerine esnemesine izin ver, arama çubuğu tam satır olsun */
            .banner-card .d-flex.flex-wrap {
                gap: 8px !important;
            }

            /* 1. DROP DOWN - Küçült */
            .banner-card .dropdown button {
                min-width: auto !important;
                padding: 0 12px !important;
                width: auto !important;
            }

            .banner-card .dropdown button span.text-truncate {
                max-width: 80px !important;
                /* Metni tamamen gizlemek yerine kısalt */
            }

            /* 2. FORM - Tam satır kaplasın (ikinci satıra düşecek) */
            .banner-card form {
                width: 100% !important;
                min-width: 100% !important;
                order: 3 !important;
                /* Mobilde alta al */
                margin-top: 4px !important;
            }

            /* Input Alanı */
            #searchInput {
                font-size: 0.9rem;
            }

            /* 3. SAĞ BUTONLAR - Üst satırda sağda kalsın */
            .banner-card .flex-shrink-0.d-flex {
                margin-left: auto;
                /* Sağa yasla */
            }

            .banner-card .flex-shrink-0 .btn {
                padding: 0 10px !important;
                height: 38px;
                display: flex;
                justify-content: center;
                align-items: center;
            }
        }

        /* ===== SMALL PHONE - 480px and below ===== */
        @@media (max-width: 480px) {
            .container {
                padding-left: 8px !important;
                padding-right: 8px !important;
            }

            .banner-card {
                padding: 8px 10px;
            }

            .banner-btn {
                height: 36px;
                min-width: 36px;
                padding: 0 8px;
                font-size: 0.85rem;
            }

            .modern-input {
                height: 36px;
                font-size: 0.85rem;
            }

            /* Input group butonu (soldaki mod seçici) boyutu eşitleme */
            .input-group .btn {
                height: 36px;
            }
        }

        /* Search Clear Button */
        .search-wrapper {
            position: relative;
            flex-grow: 1;
        }
        .search-clear-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: none;
            background: rgba(255, 255, 255, 0.2);
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.7rem;
            display: none;           /* Başlatmada gizli */
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 10;
            transition: background 0.15s;
            padding: 0;
            line-height: 1;
        }
        .search-clear-btn:hover {
            background: rgba(255, 255, 255, 0.35);
        }
        .search-clear-btn.visible {
            display: flex;
        }
        /* Clear buton varken sağ padding */
        #searchInput.has-clear {
            padding-right: 36px !important;
        }


        /* ===== MODAL STYLES ===== */
        .modal-content {
            background: linear-gradient(135deg, rgba(30, 30, 50, 0.95) 0%, rgba(20, 20, 40, 0.98) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
        }

        .modal-header {
            padding: 20px 24px 10px;
        }

        .modal-body {
            padding: 10px 24px 20px;
        }

        .modal-footer {
            padding: 10px 24px 20px;
        }

        .modal .form-control {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff;
            border-radius: 8px;
        }

        .modal .form-control:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(0, 220, 255, 0.5);
            box-shadow: 0 0 0 3px rgba(0, 220, 255, 0.1);
            color: #fff;
        }

        .modal .form-label {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.85rem;
            font-weight: 500;
        }
    </style>
}

<div class="top-bar-fixed">
    @* ===== BANNER ===== *@
        <div class="banner-shell">
            <div class="banner-card">
                <div class="d-flex flex-wrap align-items-center gap-2">

                    @* 1. Liste Seçimi *@
                    <div class="dropdown flex-shrink-0">
                        <button class="btn btn-outline-light banner-btn dropdown-toggle d-flex align-items-center gap-2"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Select List"
                            style="min-width: 140px; justify-content: space-between;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-journal-text"></i>
                                <span class="text-truncate" style="max-width: 120px;">@Model.SelectedList</span>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark shadow-lg">
                            @if (ViewBag.AllLists != null)
                            {
                                @foreach (var list in ViewBag.AllLists)
                                {
                                    <li>
                                        <a class="dropdown-item @(list == Model.SelectedList ? "active" : "")"
                                            asp-controller="Word" asp-action="Index" asp-route-listName="@list">
                                            @list
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li><a class="dropdown-item disabled" href="#">No lists available</a></li>
                            }
                        </ul>
                    </div>

                    @* 2. Arama Formu (Esnek Genişlik) *@
                    <form method="get" asp-controller="Word" asp-action="Index" class="d-flex gap-2 flex-grow-1"
                        style="min-width: 250px;">
                        <input type="hidden" name="listName" value="@Model.SelectedList" />
                        <input type="hidden" name="searchMode" id="searchModeInput"
                            value="@((Model.SearchMode ?? "starts").ToLower())" />

                        <div class="input-group">
                            <button type="button"
                                class="btn @(Model.SearchMode == "contains" ? "btn-info" : "btn-outline-light")"
                                id="searchModeToggle"
                                title="Mode: @(Model.SearchMode == "contains" ? "Contains" : "Starts with")"
                                style="border-top-left-radius: 10px; border-bottom-left-radius: 10px; border-right: none;">
                                <i class="bi @(Model.SearchMode == "contains" ? "bi-text-center" : "bi-text-left")"></i>
                            </button>
                            <div class="search-wrapper">
                                <input type="text" name="SearchTerm" id="searchInput"
                                    class="form-control modern-input border-start-0 @(string.IsNullOrEmpty(Model.SearchTerm) ? "" : "has-clear")"
                                    value="@Model.SearchTerm"
                                    placeholder="Search..." autocomplete="off"
                                    style="border-radius: 0 !important;" />
                                <button type="button" id="searchClearBtn"
                                        class="search-clear-btn @(string.IsNullOrEmpty(Model.SearchTerm) ? "" : "visible")"
                                        title="Clear">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                            <button type="submit" class="btn btn-outline-light" title="Search" style="border-top-right-radius: 10px; border-bottom-right-radius: 10px; padding: 0 16px;">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>

                    @* 3. Butonlar (Sağda Sabit) *@
                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                        <button type="button" class="btn btn-success banner-btn" data-bs-toggle="modal"
                            data-bs-target="#createWordModal" title="Add Word">
                            <i class="bi bi-plus-lg"></i>
                        </button>

                        <button type="button" class="btn btn-outline-light banner-btn" id="toggleViewBtn"
                            title="Switch View">
                            <i class="bi bi-table" id="toggleViewIcon"></i>
                        </button>
                    </div>

                </div>
            </div>
        </div>
</div>

<div class="content-area">
    @* ===== TABLE VIEW ===== *@
    @await Html.PartialAsync("_TableView", Model)

    @* ===== FLASHCARD VIEW ===== *@
    @await Html.PartialAsync("_FlashcardView", Model)
</div>

@* Scroll To Top Button *@
<button id="scrollTopBtn" class="btn position-fixed bottom-0 end-0 m-4 shadow-lg"
    style="width: 50px; height: 50px; z-index: 1000; display: none; border-radius: 12px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border: none; color: white;">
    <i class="bi bi-arrow-up"></i>
</button>

@* Create Word Modal *@
<div class="modal fade" id="createWordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Word" asp-action="CreateWord" method="post" autocomplete="off">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Add New Word</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ListName" value="@Model.SelectedList" />
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="searchMode" value="@Model.SearchMode" />
                    <div class="mb-3">
                        <label class="form-label">English</label>
                        <input type="text" name="En" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Turkish</label>
                        <input type="text" name="Tr" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Example (Optional)</label>
                        <textarea name="Example" class="form-control" rows="10"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Update Word Modal *@
<div class="modal fade" id="updateWordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-controller="Word" asp-action="UpdateWord" method="post" autocomplete="off">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Update Word</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="updateId" name="Id" />
                    <input type="hidden" id="updateListNameHidden" name="ListName" />
                    <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                    <input type="hidden" name="searchMode" value="@Model.SearchMode" />
                    <div class="mb-3">
                        <label class="form-label">English</label>
                        <input type="text" id="updateEn" name="En" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Turkish</label>
                        <input type="text" id="updateTr" name="Tr" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Example (Optional)</label>
                        <textarea id="updateExample" name="Example" class="form-control" rows="10"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-success">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.wordsData = @Html.Raw(Json.Serialize(Model.Words ?? new List<Word>()));
        window.allWordsData = @Html.Raw(Json.Serialize(ViewBag.AllWords ?? Model.Words ?? new List<Word>()));
        window.synonymGroups = @Html.Raw(Json.Serialize(ViewBag.SynonymGroups ?? new List<WordGroupDto>()));
        window.searchTermValue = '@Model.SearchTerm';
        window.searchModeValue = '@Model.SearchMode';
        window.selectedList = '@Model.SelectedList';
    </script>
    <script src="~/js/word.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Search Mode Toggle
            const modeInput = document.getElementById('searchModeInput');
            const modeBtn = document.getElementById('searchModeToggle');
            const modeIcon = modeBtn.querySelector('i');

            if (modeBtn && modeInput) {
                modeBtn.addEventListener('click', function () {
                    const currentMode = modeInput.value;
                    const newMode = currentMode === 'starts' ? 'contains' : 'starts';

                    modeInput.value = newMode;

                    // Update UI
                    if (newMode === 'contains') {
                        modeBtn.classList.remove('btn-outline-light');
                        modeBtn.classList.add('btn-info');
                        modeIcon.classList.remove('bi-text-left');
                        modeIcon.classList.add('bi-text-center');
                        modeBtn.title = "Mode: Contains";
                    } else {
                        modeBtn.classList.remove('btn-info');
                        modeBtn.classList.add('btn-outline-light');
                        modeIcon.classList.remove('bi-text-center');
                        modeIcon.classList.add('bi-text-left');
                        modeBtn.title = "Mode: Starts with";
                    }

                    // Sadece imleci input'a odakla, submit etme
                    document.getElementById('searchInput')?.focus();
                });
            }

            // Search Clear Button
            const searchInput = document.getElementById('searchInput');
            const clearBtn    = document.getElementById('searchClearBtn');

            function updateClearBtn() {
                if (!searchInput || !clearBtn) return;
                const hasText = searchInput.value.length > 0;
                clearBtn.classList.toggle('visible', hasText);
                searchInput.classList.toggle('has-clear', hasText);
            }

            if (searchInput) {
                searchInput.addEventListener('input', updateClearBtn);
                updateClearBtn(); // Sayfa yüklendiğinde kontrol et
            }

            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    searchInput.value = '';
                    updateClearBtn();
                    searchInput.focus();
                });
            }
        });
    </script>
}