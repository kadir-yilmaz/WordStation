@model WordStation.WebUI.Models.HomeViewModel

<style>
    
    /* Main Stage Container */
    .main-stage {
        display: flex;
        flex-direction: row;
        background: linear-gradient(135deg, rgba(15, 15, 35, 0.6) 0%, rgba(30, 20, 50, 0.4) 100%);
        border: 1.5px solid var(--glass-border);
        border-radius: 24px;
        min-height: 400px; /* Reduced to fit viewport */
        max-height: calc(100vh - 280px); /* Prevent page scroll */
        overflow: hidden;
        position: relative;
        backdrop-filter: blur(16px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    }

    /* 3-COLUMN / SPLIT GRID LAYOUT
       ====================== */

    /* 1. Example (Left) - 50% */
    .stage-col-example {
        flex: 0 0 50%;
        max-width: 50%;
        width: auto;
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: none;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        overflow-y: auto;
    }

    /* 2. Flashcard (Right) - 50% */
    .stage-col-flashcard {
        flex: 0 0 50%;
        max-width: 50%;
        width: auto;
        padding: 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        position: relative;
    }

    /* 3. Thesaurus (Styles Only, not used in main grid) */
    .stage-col-thesaurus {
        flex: 0 0 100%;
        width: 100%;
        padding: 24px;
        background: rgba(0, 0, 0, 0.15);
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    }

    .example-text {
        font-size: 1rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
        white-space: pre-wrap;
        word-wrap: break-word;
        flex: 1;
        overflow-y: auto;
        /* No max-height - fills container */
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    }



    /* Thesaurus Container - Top Fixed Area (Global) */
    .synonyms-container-top {
        width: 100%;
        margin-bottom: 12px; /* Reduced margin */
        padding: 12px 16px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow-x: auto;
        overflow-y: hidden;
        white-space: nowrap;
        display: flex;
        align-items: center;
        min-height: 75px; /* Fixed height: Content + Padding + Scrollbar */
        scrollbar-width: thin; /* Show thin scrollbar by default (PC) */
        scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    }
    
    /* Hide scrollbar only on touch devices if desired, or keep thin */
    /* .synonyms-container-top::-webkit-scrollbar { display: none; } */

    /* Scrollbar Styling for Webkit */
    .synonyms-container-top::-webkit-scrollbar {
        height: 6px;
    }
    .synonyms-container-top::-webkit-scrollbar-track {
        background: transparent;
    }
    .synonyms-container-top::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
    }

    /* Synonyms Title (if needed in future) */
    .synonyms-title {
        font-size: 0.85rem;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.5);
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    /* Synonym Badges */
    .flashcard-synonym-badge {
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.8);
        padding: 8px 16px; /* Larger padding global */
        border-radius: 12px;
        font-size: 1rem; /* Larger font global */
        display: inline-block;
        transition: all 0.2s;
        text-decoration: none;
        cursor: pointer;
    }

    .flashcard-synonym-badge:hover {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        transform: translateY(-1px);
    }

    .example-text::-webkit-scrollbar { width: 5px; }
    .example-text::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.2); border-radius: 10px; }

    /* Flashcard Section (Right Panel) */
    .stage-right {
        flex: 1;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        background: linear-gradient(135deg, rgba(15, 15, 35, 0.2) 0%, rgba(20, 15, 40, 0.15) 100%);
    }

    .stage-col-flashcard .dropdown-toggle::after { display: none; }

    /* Flashcard */
    .flashcard-container {
        perspective: 1200px;
        width: 100%;
        max-width: 420px;
        height: 220px;
        margin-bottom: 24px;
    }

    .flashcard {
        position: relative;
        width: 100%;
        height: 100%;
        cursor: pointer;
        transition: transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
        transform-style: preserve-3d;
    }

    .flashcard.flipped { transform: rotateY(180deg); }

    .flashcard-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, 0.35);
    }

    .flashcard-front { background: var(--primary-gradient); }
    .flashcard-back { background: var(--success-gradient); transform: rotateY(180deg); }

    .flashcard-word {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
        text-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
        text-align: center;
        color: #fff;
    }

    /* Controls */
    .stage-controls {
        width: 100%;
        max-width: 400px;
    }

    .index-label, #flashcardProgress {
        font-size: 0.875rem;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 600;
        background: rgba(255, 255, 255, 0.08);
        padding: 6px 16px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: inline-block;
    }

    /* Speak Button */
    .btn-speak {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.07);
        color: rgba(255, 255, 255, 0.75);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        flex-shrink: 0;
        padding: 0;
        line-height: 1;
    }

    .btn-speak:hover {
        background: rgba(99, 179, 237, 0.2);
        border-color: rgba(99, 179, 237, 0.5);
        color: #63b3ed;
        transform: scale(1.1);
    }

    .btn-speak.speaking {
        background: rgba(99, 179, 237, 0.25);
        border-color: #63b3ed;
        color: #63b3ed;
        animation: speakPulse 0.8s ease-in-out infinite alternate;
    }

    @@keyframes speakPulse {
        from { box-shadow: 0 0 0 0 rgba(99, 179, 237, 0.4); }
        to   { box-shadow: 0 0 0 7px rgba(99, 179, 237, 0); }
    }

    .progress-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 16px;
    }

    /* Custom Range Slider */
    .custom-slider {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 14px;
        background: rgba(30, 40, 55, 0.95);
        border-radius: 8px;
        margin-bottom: 20px;
        cursor: pointer;
    }

    .custom-slider:focus {
        outline: none;
    }

    .custom-slider::-webkit-slider-runnable-track {
        width: 100%;
        height: 14px;
        background: inherit;
        border-radius: 8px;
    }

    .custom-slider::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        margin-top: -4px;
        border: none;
    }

    .custom-slider::-moz-range-track {
        width: 100%;
        height: 14px;
        background: rgba(30, 40, 55, 0.95);
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .custom-slider::-moz-range-thumb {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: #fff;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        border: none;
    }

    .custom-slider::-moz-range-progress {
        background: #10b981;
        height: 14px;
        border-radius: 8px 0 0 8px;
    }

    .stage-controls .btn-outline-light {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        background: rgba(255, 255, 255, 0.05);
        color: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.25s ease;
    }

    .stage-controls .btn-outline-light:hover {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(255, 255, 255, 0.4);
        color: #fff;
        transform: translateY(-2px);
    }

    .stage-controls .btn-success {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: var(--success-gradient);
        border: none;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(13, 148, 136, 0.35);
        transition: all 0.25s ease;
    }

    .stage-controls .btn-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(16, 185, 129, 0.4);
    }

    .stage-controls .btn-success i { font-size: 1.75rem; color: #fff; }
    .stage-controls .btn-outline-light i { font-size: 1.5rem; }

    /* Empty State */
    .border-dashed { border-style: dashed !important; }

    /* =============================================
       BOOTSTRAP RESPONSIVE BREAKPOINTS
       ============================================= */

    /* Large devices (desktops, 992px and up) - Default styles above */

    /* Medium devices (tablets, 768px to 991px) */
    @@media (max-width: 991.98px) {
        .main-stage {
            flex-direction: column;
            min-height: auto;
        }

        .layout-left-col {
            flex: 0 0 100%;
            max-width: 100%;
            border-right: none;
        }

        .stage-col-example {
            flex: 0 0 auto;
            max-width: 100%;
            width: 100%;
            max-width: 100%;
            width: 100%;
            height: 220px;
            border-right: none;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            padding: 20px;
            overflow-y: auto;
        }

        .stage-col-flashcard {
            padding: 12px 20px; /* Reduced top padding */
            max-width: 100%;
            width: 100%;
            flex: 0 0 auto;
            /* Fix vertical alignment: Start from top */
            justify-content: flex-start !important; 
            /* Increased padding/margin to clear the fixed bottom dock */
            padding-bottom: 220px; 
            min-height: 500px; /* Ensure enough scrollable area */
        }

        .flashcard-container {
            max-width: 380px;
            height: 180px;
            margin-bottom: 20px;
        }

        .flashcard-word { font-size: 2rem; }

        /* Mobile Fixed Bottom Controls */
        .stage-controls { 
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            max-width: 100%;
            z-index: 1000;
            background: rgba(18, 18, 28, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding: 16px 24px 24px 24px;
            border-radius: 24px 24px 0 0;
            box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Adjust layout inside fixed controls */
        .stage-controls .text-center.mb-2 {
            margin-bottom: 4px !important;
            width: 100%;
            display: flex;
            justify-content: center;
        }

        .index-label {
            font-size: 0.75rem;
            padding: 4px 12px;
            background: rgba(255,255,255,0.05);
            border: none;
            margin-bottom: 4px;
        }

        .custom-slider {
            margin-bottom: 16px !important;
            height: 10px; /* Thicker slider for better visibility */
        }
        
        .custom-slider::-webkit-slider-runnable-track {
            height: 10px; /* Match input height */
            border-radius: 5px;
        }
        
        .custom-slider::-webkit-slider-thumb {
            width: 18px;
            height: 18px;
            margin-top: -4px; /* Centering: (10-18)/2 */
        }

        .stage-controls .d-flex.gap-4 {
            width: 100%;
            justify-content: space-evenly !important; /* Distribute buttons */
            gap: 10px !important;
        }

        .stage-controls .btn-outline-light,
        .stage-controls .btn-success {
            width: 60px; /* Larger touch targets */
            height: 50px;
            border-radius: 16px;
        }

        .stage-controls .btn-success i { font-size: 1.6rem; }
        .stage-controls .btn-outline-light i { font-size: 1.4rem; }
    }

    /* Small devices (landscape phones, 576px to 767px) */
    @@media (max-width: 767.98px) {
        .main-stage {
            border-radius: 18px;
        }

        .stage-col-example {
            height: 250px;
            padding: 16px;
        }

        .example-text { font-size: 1rem; line-height: 1.6; }

        .stage-col-flashcard { padding: 20px 16px; }

        .flashcard-container {
            max-width: 360px;
            height: 180px;
            margin-bottom: 20px;
        }

        .flashcard-face { padding: 20px; border-radius: 16px; }
        .flashcard-word { font-size: 1.75rem; }

        .stage-controls { max-width: 340px; }
        .index-label, #flashcardProgress { font-size: 0.85rem; padding: 6px 16px; margin-bottom: 12px; }


        .stage-controls .btn-outline-light,
        .stage-controls .btn-success {
            width: 54px;
            height: 54px;
            border-radius: 14px;
        }

        .stage-controls .d-flex.gap-4 { gap: 20px !important; }
        .stage-controls .btn-success i { font-size: 1.5rem; }
        .stage-controls .btn-outline-light i { font-size: 1.25rem; }
    }

    /* Extra small devices (portrait phones, less than 576px) */
    @@media (max-width: 575.98px) {
        .main-stage {
            border-radius: 14px;
        }

        .stage-col-example {
            height: 150px; /* Reduced for small screens */
            padding: 14px;
        }

        .example-text { font-size: 1rem; line-height: 1.5; }

        .stage-col-flashcard { 
            padding: 16px 14px; 
            padding-bottom: 200px; /* Clear fixed controls */
        }

        .flashcard-container {
            max-width: 100%;
            height: 180px;
            margin-bottom: 16px;
        }

        .flashcard-face { padding: 16px; border-radius: 14px; }
        .flashcard-word { font-size: 1.75rem; }

        /* Reuse styles from 991px break point but adjust padding if needed */
        .stage-controls { max-width: 100%; }
        /* padding override inside fixed container */
        .stage-controls { padding: 12px 20px 20px 20px; }
        .index-label, #flashcardProgress { font-size: 0.8rem; padding: 5px 14px; margin-bottom: 10px; }

        .stage-controls .btn-outline-light,
        .stage-controls .btn-success {
            width: 50px;
            height: 50px;
            border-radius: 14px;
        }

        .stage-controls .d-flex.gap-4 { gap: 16px !important; }
        .stage-controls .btn-success i { font-size: 1.4rem; }
        .stage-controls .btn-outline-light i { font-size: 1.15rem; }
        

    }
</style>

<div id="flashcardView">
    @if (Model.Words != null && Model.Words.Any())
    {
@* Thesaurus (Global Top) - Always Visible *@
        <div id="flashcardSynonymsContainer" class="synonyms-container-top">
            <div id="flashcardSynonyms" class="d-flex flex-nowrap gap-3"></div>
        </div>

        <div class="main-stage">
            @* 1. Example (Left) *@
            <div class="stage-col-example">
                <div id="flashcardExampleText" class="example-text">
                    Loading...
                </div>
            </div>

            @* 2. Flashcard (Right) *@
            <div class="stage-col-flashcard">
                
                @* Flashcard Header: Menu (Right) *@
                <div class="d-flex justify-content-end align-items-center w-100 mb-3 px-2">
                    
                    @* Action Menu (Right) *@
                    <div class="dropdown">
                        <button type="button"
                                class="btn btn-link text-white-50 text-decoration-none p-0"
                                data-bs-toggle="dropdown">
                            <i class="bi bi-three-dots-vertical fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button type="button"
                                        class="dropdown-item"
                                        id="flashcardUpdateBtn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#updateWordModal">
                                    <i class="bi bi-pencil-fill me-2"></i>Update
                                </button>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button type="button"
                                        class="dropdown-item text-danger"
                                        id="flashcardDeleteBtn">
                                    <i class="bi bi-trash-fill me-2"></i>Delete
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>

                @* Flashcard *@
                <div class="flashcard-container mb-4" id="flashcardContainer">
                    <div class="flashcard" id="flashcard">
                        <div class="flashcard-face flashcard-front">
                            <h1 class="flashcard-word" id="flashcardWord">Word</h1>
                        </div>
                        <div class="flashcard-face flashcard-back">
                            <h2 class="flashcard-word" id="flashcardTranslation">Translation</h2>
                        </div>
                    </div>
                </div>

                @* Controls (Slider & Buttons Only) *@
                <div class="stage-controls w-100">
                    <div class="progress-row">
                        <span id="flashcardProgress" class="index-label">1/0</span>
                        <button id="speakBtn" class="btn-speak" title="Kelimeyi seslendir (S)">
                            <i class="bi bi-volume-up-fill" style="font-size: 0.9rem;"></i>
                        </button>
                    </div>

                    <input type="range" class="form-range custom-slider mb-4" id="interactiveSlider" min="0" value="0">

                    <div class="d-flex gap-4 justify-content-center align-items-center">
                        <button class="btn btn-outline-light"
                                id="flashcardPrev"
                                title="Previous (Left Arrow)">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <button class="btn btn-success"
                                id="flashcardRandom"
                                title="Random (Down Arrow)">
                            <i class="bi bi-shuffle"></i>
                        </button>

                        <button class="btn btn-outline-light"
                                id="flashcardNext"
                                title="Next (Right Arrow)">
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>


        </div>
        
    }
    else
    {
        <div class="card text-center p-5 bg-transparent border-secondary border-dashed">
            <i class="bi bi-inbox" style="font-size: 4rem; opacity: 0.5;"></i>
            <p class="mt-3 mb-0 text-white-50">No words in this list yet.</p>
        </div>
    }
</div>
