@model RegisterModel
@{
    ViewData["Title"] = "Üye Ol";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="container">
    <div class="login-container">
        
        <div class="form-container">
            <h3 class="text-center mb-4" style="color: var(--account-primary)">Yeni Hesap Oluştur</h3>
            
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>

            <form method="post" asp-action="Register" autocomplete="off">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-posta adresi</label>
                    <input asp-for="Email" class="form-control" placeholder="E-posta adresinizi girin" autocomplete="new-email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <div class="password-wrapper">
                        <input type="password" asp-for="Password" class="form-control" placeholder="Şifrenizi oluşturun" id="regPassword" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePassword('regPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Şifre Tekrarı</label>
                    <div class="password-wrapper">
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifrenizi tekrar girin" id="confirmPassword" autocomplete="new-password" />
                        <button type="button" class="password-toggle-btn" onclick="togglePassword('confirmPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-account">
                    Hesabı Oluştur
                </button>
            </form>

            <div class="auth-divider">
                <span>veya</span>
            </div>

            <a asp-action="GoogleLogin" class="btn btn-google text-decoration-none">
                <i class="fab fa-google"></i>
                Google ile devam et
            </a>

            <div class="text-center mt-3">
                <p class="auth-footer-text">Zaten bir hesabınız var mı? <a asp-action="Login" class="forgot-password" style="font-weight: 600">Giriş yapın</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = event.currentTarget.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
    </script>
}
