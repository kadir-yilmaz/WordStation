@model LoginModel

@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
}

<div class="container">
    <div class="login-container">
        
        <div class="form-container">
            <h3 class="text-center mb-4" style="color: var(--account-primary)">Giriş Yap</h3>
            
            <div class="text-danger" asp-validation-summary="ModelOnly"></div>

            <form method="post" asp-action="Login">
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">E-posta adresi</label>
                    <input asp-for="Email" class="form-control" placeholder="E-posta adresinizi girin" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Şifre</label>
                    <div class="password-wrapper">
                        <input type="password" asp-for="Password" class="form-control" placeholder="Şifrenizi girin" id="loginPassword" />
                        <button type="button" class="password-toggle-btn" onclick="togglePassword('loginPassword')">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3 text-end">
                    <a href="#" class="forgot-password">Şifremi unuttum</a>
                </div>

                <button type="submit" class="btn btn-account">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>
                    Giriş yap
                </button>
            </form>

            <div class="auth-divider">
                <span>veya</span>
            </div>

            <a asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-google text-decoration-none">
                <i class="fab fa-google"></i>
                Google ile devam et
            </a>

            <div class="text-center mt-3">
                <p class="auth-footer-text">Hesabınız yok mu? <a asp-action="Register" class="forgot-password" style="font-weight: 600">Üye olun</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePassword(inputId) {
            const input = document.getElementById(inputId);
            const icon = event.currentTarget.querySelector('i');

            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }
    </script>
}