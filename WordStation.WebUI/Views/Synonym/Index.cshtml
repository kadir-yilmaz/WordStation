@model IEnumerable<WordStation.WebUI.Models.WordGroupDto>

@{
    ViewData["Title"] = "Synonyms";
}

@section Styles {
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --accent-color: #34d399;
        }

        .premium-container {
            padding-top: 2rem;
            padding-bottom: 4rem;
        }

        .header-section {
            margin-bottom: 3rem;
            text-align: center;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            background: linear-gradient(to right, #fff, rgba(255,255,255,0.7));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 1rem;
            letter-spacing: -1px;
        }

        .page-subtitle {
            color: rgba(255, 255, 255, 0.5);
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .search-wrap {
            max-width: 500px;
            margin: 0 auto 3rem;
            position: relative;
        }

        .search-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 100px;
            padding: 14px 24px;
            padding-left: 50px;
            color: #fff;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .search-input:focus {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(102, 126, 234, 0.5);
            box-shadow: 0 0 25px rgba(102, 126, 234, 0.15);
            outline: none;
        }

        .search-icon {
            position: absolute;
            left: 20px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.4);
            font-size: 1.2rem;
        }

        .table-glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        }

        .premium-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            color: #fff;
        }

        .premium-table th {
            background: rgba(255, 255, 255, 0.03);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            padding: 20px 30px;
            color: rgba(255, 255, 255, 0.5);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .premium-table td {
            padding: 24px 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            vertical-align: middle;
        }

        .premium-table tr:last-child td {
            border-bottom: none;
        }

        .premium-table tr {
            transition: background 0.2s ease;
        }

        .premium-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .tr-word {
            font-weight: 700;
            font-size: 1.15rem;
            color: var(--accent-color);
            text-shadow: 0 0 20px rgba(52, 211, 153, 0.2);
        }

        .synonym-badges {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .synonym-badge {
            background: rgba(102, 126, 234, 0.12);
            border: 1px solid rgba(102, 126, 234, 0.2);
            color: #a5b4fc;
            padding: 6px 16px;
            border-radius: 12px;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .synonym-badge:hover {
            background: var(--primary-gradient);
            color: #fff;
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
            border-color: transparent;
        }

        .synonym-badge i {
            opacity: 0;
            font-size: 0.8rem;
            transition: opacity 0.2s ease;
        }

        .synonym-badge:hover i {
            opacity: 1;
        }

        .empty-state {
            text-align: center;
            padding: 100px 40px;
            opacity: 0.7;
        }

        .empty-state i {
            font-size: 5rem;
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 24px;
            display: block;
        }

        .badge-list-name {
            font-size: 0.7rem;
            background: rgba(255, 255, 255, 0.1);
            padding: 2px 8px;
            border-radius: 4px;
            color: rgba(255, 255, 255, 0.6);
            margin-top: 4px;
            display: block;
            width: fit-content;
        }

        /* Micro-animations */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .animate-fade-up {
            animation: fadeInUp 0.6s ease forwards;
        }

        .stagger-1 { animation-delay: 0.1s; }
        .stagger-2 { animation-delay: 0.2s; }
        .stagger-3 { animation-delay: 0.3s; }
    </style>
}

<div class="container premium-container">
    <div class="header-section animate-fade-up">
        <h1 class="page-title">Synonyms</h1>
        <p class="page-subtitle">
            Words with the same meaning are automatically grouped together. 
            Click on the words to see details.
        </p>
    </div>

    <div class="search-wrap animate-fade-up stagger-1">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="synonymsSearchInput" class="search-input" placeholder="Search by English or Turkish word..." autocomplete="off">
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-glass-card animate-fade-up stagger-2">
            <table class="premium-table" id="synonymsTable">
                <thead>
                    <tr>
                        <th style="width: 30%">Meaning</th>
                        <th style="width: 70%">Synonyms</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model)
                    {
                        <tr class="synonyms-row" data-tr="@group.Tr.ToLower()" data-en="@string.Join(" ", group.Words.Select(w => w.En.ToLower()))">
                            <td>
                                <div class="tr-word">@group.Tr</div>
                                <div class="text-white-50 small mt-1">@group.Words.Count words found</div>
                            </td>
                            <td>
                                <div class="synonym-badges">
                                    @foreach (var word in group.Words)
                                    {
                                        <div class="synonym-badge-wrapper">
                                            <span class="synonym-badge" 
                                                  data-en="@word.En" 
                                                  data-tr="@word.Tr" 
                                                  data-example="@word.Example"
                                                  onclick="showWordDetailFromElement(this)">
                                                @word.En
                                                <i class="bi bi-eye-fill"></i>
                                            </span>
                                            <span class="badge-list-name">@word.ListName</span>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-glass-card animate-fade-up stagger-2">
            <div class="empty-state">
                <i class="bi bi-diagram-3"></i>
                <h3>No synonyms found yet</h3>
                <p>Words with the same meaning will appear here once you add at least 2 of them.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('synonymsSearchInput');
            const rows = document.querySelectorAll('.synonyms-row');

            if (searchInput) {
                searchInput.addEventListener('input', function() {
                    const term = this.value.toLowerCase().trim();
                    
                    rows.forEach(row => {
                        const tr = row.dataset.tr;
                        const en = row.dataset.en;
                        
                        if (tr.includes(term) || en.includes(term)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });
                });
            }
        });
    </script>
}
