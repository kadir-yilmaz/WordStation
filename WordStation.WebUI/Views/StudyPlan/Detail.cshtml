@model List<WordStation.EL.Dtos.StudyPlanDayDto>
@{
    var plan = ViewBag.Plan as WordStation.EL.Dtos.StudyPlanSummaryDto;
    ViewData["Title"] = plan != null ? plan.Name : "Plan Detayı";
    var progressPercent = plan != null ? (int)Math.Round(plan.Progress * 100) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/study-plan.css" asp-append-version="true" />
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none sp-subtitle small d-inline-flex align-items-center gap-1 mb-2">
            <i class="bi bi-arrow-left"></i> Tüm Planlarım
        </a>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h2 class="sp-title mb-0">
                <i class="bi bi-calendar2-range text-success me-2"></i>@(plan?.Name ?? "Plan Detayı")
            </h2>
            <div class="d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@plan?.Id" method="post" onsubmit="return confirm('Bu planı silmek istediğinize emin misiniz?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-trash3 me-1"></i>Planı Sil
                    </button>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-opacity-25 border-0 text-white alert-dismissible fade show mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.2);">
            <i class="bi bi-check-circle-fill text-success me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Üst İlerleme Kartı (Dark) -->
    <div class="sp-card p-4 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-md-6">
                <div class="d-flex justify-content-between small mb-2">
                    <span class="text-secondary fw-semibold">Genel İlerleme</span>
                    <span class="fw-bold text-success">%@progressPercent Tamamlandı</span>
                </div>
                <div class="sp-progress-container mb-2">
                    <div class="sp-progress-bar" style="width: @progressPercent%;"></div>
                </div>
                <div class="text-secondary small">
                    Gün @plan?.CompletedDays / @plan?.TotalDays tamamlandı
                </div>
            </div>
            <div class="col-md-6">
                <div class="row text-center g-2">
                    <div class="col-4">
                        <div class="sp-stat-box">
                            <div class="sp-stat-label">Toplam Gün</div>
                            <div class="sp-stat-val">@plan?.TotalDays</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="sp-stat-box">
                            <div class="sp-stat-label">Günlük Sınır</div>
                            <div class="sp-stat-val">@plan?.DailyWordLimit</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="sp-stat-box">
                            <div class="sp-stat-label">Toplam Kelime</div>
                            <div class="sp-stat-val">@plan?.TotalWords</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var day in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="sp-card p-4 h-100 d-flex flex-column @(day.IsCompleted ? "sp-card-completed" : "")">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (day.IsCompleted)
                                {
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                }
                                <h5 class="fw-bold mb-0 text-white">Gün @day.DayNumber</h5>
                            </div>
                            <button type="button" class="btn btn-sm sp-btn-outline btn-view-words" data-plan-id="@plan?.Id" data-day-number="@day.DayNumber" title="Kelimeleri Önizle">
                                <i class="bi bi-eye"></i> Kelimeler
                            </button>
                        </div>

                        <div class="mt-auto pt-2">
                            @if (day.IsCompleted && day.QuizScore.HasValue)
                            {
                                <div class="d-flex justify-content-between align-items-center gap-2 p-2 px-3 rounded-4" style="background: rgba(255, 255, 255, 0.035);">
                                    <!-- Sol: Quiz Sonucu -->
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-3 px-2 py-1 fw-bold text-center" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 0.95rem;">
                                            %@(day.QuizScore > 100 ? (int)Math.Round(day.QuizScore.Value / 2.0) : day.QuizScore)
                                        </div>
                                        <div class="small lh-sm text-secondary">
                                            <div><span class="text-success fw-bold">@day.CorrectCount</span> D <span class="text-secondary opacity-50">/</span> <span class="text-danger fw-bold">@day.WrongCount</span> Y</div>
                                            <div style="font-size: 0.7rem; color: #94a3b8;">En İyi Skor</div>
                                        </div>
                                    </div>
                                    <!-- Sağ: Tekrar Çöz Butonu -->
                                    <a asp-action="Quiz" asp-route-id="@plan?.Id" asp-route-dayNumber="@day.DayNumber" class="btn btn-sm sp-btn-outline d-inline-flex align-items-center gap-1 px-3 py-2 text-nowrap" style="border-radius: 12px;">
                                        <i class="bi bi-arrow-clockwise"></i> Tekrar Çöz
                                    </a>
                                </div>
                            }
                            else
                            {
                                <a asp-action="Quiz" asp-route-id="@plan?.Id" asp-route-dayNumber="@day.DayNumber" class="btn w-100 sp-btn-primary justify-content-center">
                                    <i class="bi bi-play-fill me-1"></i>
                                    Günün Quizini Çöz
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-info bg-opacity-25 border-0 text-white">Bu plan için henüz gün kaydı bulunmamaktadır.</div>
            </div>
        }
    </div>
</div>

<!-- Kelimeleri İnceleme Modalı (Dark Mode - Genişletilmiş ve Yatay) -->
<div class="modal fade" id="wordsModal" tabindex="-1" aria-labelledby="wordsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg" style="max-width: 900px;">
        <div class="modal-content sp-modal-content shadow-lg" style="max-height: 85vh;">
            <div class="modal-header border-0 px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
                        <i class="bi bi-book"></i>
                    </div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="wordsModalLabel">Günün Kelimeleri</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalWordsContent" style="max-height: 72vh; overflow-y: auto;">
                <div class="text-center py-4">
                    <div class="spinner-border text-success" role="status">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const preloadedDays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model ?? new List<WordStation.EL.Dtos.StudyPlanDayDto>(), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        function renderDayWords(day) {
            if (!day || !day.words || day.words.length === 0) {
                return '<div class="text-secondary py-4 text-center">Bu gün için kayıtlı kelime bulunamadı.</div>';
            }

            let html = '<div class="row g-3">';
            for (const word of day.words) {
                const en = word.en || '';
                const tr = word.tr || '';
                const example = (word.example || '').trim();
                const isCorrect = word.isCorrectInQuiz;

                let badgeHtml = '';
                if (day.isCompleted) {
                    if (isCorrect) {
                        badgeHtml = '<span class="badge rounded-pill px-2.5 py-1" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: none; font-size: 0.75rem;"><i class="bi bi-check-circle-fill me-1"></i>Doğru</span>';
                    } else {
                        badgeHtml = '<span class="badge rounded-pill px-2.5 py-1" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: none; font-size: 0.75rem;"><i class="bi bi-x-circle-fill me-1"></i>Yanlış</span>';
                    }
                }

                let exampleHtml = '';
                if (example) {
                    const safeExample = example
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;');

                    exampleHtml = `
                        <div class="flex-grow-1 d-flex flex-column justify-content-center p-3 rounded-3 mt-1" style="background: rgba(0, 0, 0, 0.25); color: #cbd5e1; white-space: pre-line; word-break: break-word; line-height: 1.55; font-size: 0.85rem;">
                            ${safeExample}
                        </div>`;
                }

                html += `
                    <div class="col-md-6">
                        <div class="p-3 rounded-4 h-100 d-flex flex-column" style="background: rgba(255, 255, 255, 0.035); transition: background 0.2s ease;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-white fs-5">${en}</span>
                                    <button type="button" class="btn btn-sm rounded-circle p-0 d-inline-flex align-items-center justify-content-center" 
                                            style="width: 28px; height: 28px; background: rgba(16, 185, 129, 0.15); color: #10b981; border: none;"
                                            onclick="if(window.speakWord) window.speakWord('${en}', this);"
                                            title="Telaffuzu Dinle">
                                        <i class="bi bi-volume-up-fill" style="font-size: 0.85rem;"></i>
                                    </button>
                                </div>
                                ${badgeHtml}
                            </div>
                            <div class="fw-semibold mb-2" style="color: #38bdf8; font-size: 0.95rem;">
                                ${tr}
                            </div>
                            ${exampleHtml}
                        </div>
                    </div>`;
            }
            html += '</div>';
            return html;
        }

        document.addEventListener('DOMContentLoaded', function () {
            const modalEl = document.getElementById('wordsModal');
            const modal = new bootstrap.Modal(modalEl);
            const content = document.getElementById('modalWordsContent');
            const titleEl = document.getElementById('wordsModalLabel');

            const daysMap = new Map();
            if (Array.isArray(preloadedDays)) {
                preloadedDays.forEach(d => daysMap.set(Number(d.dayNumber), d));
            }

            document.querySelectorAll('.btn-view-words').forEach(btn => {
                btn.addEventListener('click', function () {
                    const planId = this.getAttribute('data-plan-id');
                    const dayNumber = Number(this.getAttribute('data-day-number'));

                    if (titleEl) {
                        titleEl.innerText = `Gün ${dayNumber} Kelimeleri`;
                    }

                    modal.show();

                    // Anında yerel bellekten aç (0ms gecikme)
                    if (daysMap.has(dayNumber)) {
                        content.innerHTML = renderDayWords(daysMap.get(dayNumber));
                        return;
                    }

                    // Yedek AJAX (önbellekte bulunamazsa)
                    content.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-success" role="status"></div></div>';
                    fetch(`/StudyPlan/DayWords?planId=${planId}&dayNumber=${dayNumber}`)
                        .then(res => res.text())
                        .then(html => {
                            content.innerHTML = html;
                        })
                        .catch(err => {
                            content.innerHTML = '<div class="alert alert-danger bg-opacity-25 border-0 text-danger">Kelimeler yüklenemedi.</div>';
                        });
                });
            });
        });
    </script>
}
