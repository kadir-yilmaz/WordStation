<div class="modal fade" id="wordDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: rgba(30, 30, 50, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-3 flex-grow-1">
                    <h5 class="modal-title fs-2 fw-bold text-white ps-0 mb-0" id="detailWordEn"></h5>
                    <button id="detailSpeakBtn"
                            onclick="window.speakWord(document.getElementById('detailWordEn').textContent)"
                            style="width:32px;height:32px;border-radius:50%;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.75);display:inline-flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.2s;flex-shrink:0;padding:0;"
                            title="Seslendir (.)">
                        <i class="bi bi-volume-up-fill" style="font-size:0.85rem;"></i>
                    </button>
                </div>
                <button type="button" class="btn-close btn-close-white ms-2" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pb-4 pt-2">
                <h4 class="fw-bold mb-4" id="detailWordTr" style="color: #34d399; text-shadow: 0 0 20px rgba(52, 211, 153, 0.3);"></h4>
                <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <small class="text-uppercase text-white-50 fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 1px;">Example Sentence</small>
                    <p class="mb-0 text-white" id="detailWordExample" style="white-space: pre-wrap; line-height: 1.6;"></p>
                </div>
            </div>
        </div>
    </div>
</div>
