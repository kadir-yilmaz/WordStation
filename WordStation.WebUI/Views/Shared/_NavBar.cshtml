<header>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Word" asp-action="Index">
                WordStation
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                @* Sol taraf - Ana navigasyon linkleri *@
                <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-collection me-1"></i>My Lists
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Synonym" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Synonym" asp-action="Index">
                            <i class="bi bi-diagram-3 me-1"></i>Synonyms
                        </a>
                    </li>
                </ul>

                @* Sağ taraf - Auth durumuna göre değişen kısım *@
                <ul class="navbar-nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-1"></i>Hesabım
                            </a>
                            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                                <div class="dropdown-item-text text-muted small">@User.Identity?.Name</div>
                                <hr class="dropdown-divider">

                                <a class="dropdown-item" asp-controller="CookieDemo" asp-action="Index">
                                    <i class="fas fa-cookie-bite me-2"></i> Cookie X-Ray
                                </a>

                                <hr class="dropdown-divider">
                                <a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
