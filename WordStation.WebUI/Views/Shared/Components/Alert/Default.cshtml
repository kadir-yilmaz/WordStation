@using WordStation.WebUI.Models
@model AlertModel

@{
    var alertClass = Model.Type switch
    {
        AlertType.Success => "alert-success",
        AlertType.Error => "alert-danger",
        AlertType.Info => "alert-info",
        _ => "alert-info"
    };

    var iconClass = Model.Type switch
    {
        AlertType.Success => "bi-check-circle-fill",
        AlertType.Error => "bi-exclamation-triangle-fill",
        AlertType.Info => "bi-info-circle-fill",
        _ => "bi-info-circle-fill"
    };

    var accentColor = Model.Type switch
    {
        AlertType.Success => "#34d399",
        AlertType.Error => "#f87171",
        AlertType.Info => "#60a5fa",
        _ => "#60a5fa"
    };
}

<div class="toast-container position-fixed start-0 p-3" style="bottom: 20px; z-index: 10000;">
    <div id="dynamicAlert" class="alert @alertClass alert-dismissible fade show shadow-lg mb-0" role="alert"
        style="min-width: 300px; max-width: 450px; background: rgba(30, 30, 50, 0.95); backdrop-filter: blur(10px); color: #fff; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.1);">

        <div class="d-flex align-items-start">
            <div class="me-3 fs-4" style="color: @accentColor">
                <i class="bi @iconClass"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="alert-heading fw-bold mb-1" style="color: @accentColor">@Model.Title</h6>
                <p class="mb-0 small opacity-75">@Model.Message</p>
            </div>
            <button type="button" class="btn-close btn-close-white ms-3" data-bs-dismiss="alert"
                aria-label="Close"></button>
        </div>

        @* Progress bar for auto-close visual feedback *@
        <div class="alert-progress"
            style="position: absolute; bottom: 0; left: 0; height: 3px; width: 100%; background: rgba(255,255,255,0.1); border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; overflow: hidden;">
            <div id="alertProgressBar"
                style="height: 100%; width: 100%; background: @accentColor; transition: width 5s linear;"></div>
        </div>
    </div>
</div>

<style>
    #dynamicAlert {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        border-right: 1px solid rgba(255, 255, 255, 0.1);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        animation: slideInLeft 0.3s ease-out;
    }

    @@keyframes slideInLeft {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const alertEl = document.getElementById('dynamicAlert');
        const progressBar = document.getElementById('alertProgressBar');

        if (alertEl && progressBar) {
            // Start progress bar animation
            setTimeout(() => {
                progressBar.style.width = '0%';
            }, 50);

            // Auto close after 5 seconds
            setTimeout(() => {
                const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                if (bsAlert) bsAlert.close();
            }, 5000);
        }
    });
</script>
