
@* _Layout.cshtml *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WordStation</title>

    @* === Stil Kütüphaneleri === *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Yerel Font Awesome (LibMan üzerinden) *@
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    @* Bootstrap Icons (CDN) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    @* Siteye özel CSS (Bootstrap ve ikonlardan sonra gelmeli) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Sayfalara özel CSS alanı *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    WordStation
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">
                        @* Navbar linkleri buraya eklenebilir *@
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* === Script Kütüphaneleri === *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Sayfalara özel scriptler *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
