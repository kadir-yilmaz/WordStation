
@* _Layout.cshtml *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WordStation</title>

    @* === Stil Kütüphaneleri === *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    @* Yerel Font Awesome (LibMan üzerinden) *@
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    @* Bootstrap Icons (CDN) *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    @* Siteye özel CSS (Bootstrap ve ikonlardan sonra gelmeli) *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Sayfalara özel CSS alanı *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <partial name="_NavBar" />
    @await Component.InvokeAsync("Alert")

    <div class="container flex-grow-1 mt-2 mt-lg-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* === Script Kütüphaneleri === *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Sayfalara özel scriptler *@
    @await RenderSectionAsync("Scripts", required: false)
    @* Word Detail Global Modal *@
    <div class="modal fade" id="wordDetailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background: rgba(30, 30, 50, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fs-2 fw-bold text-white ps-0" id="detailWordEn"></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pb-4 pt-2">
                    <h4 class="fw-bold mb-4" id="detailWordTr" style="color: #34d399; text-shadow: 0 0 20px rgba(52, 211, 153, 0.3);"></h4>
                    <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                        <small class="text-uppercase text-white-50 fw-bold mb-2 d-block" style="font-size: 0.7rem; letter-spacing: 1px;">Example Sentence</small>
                        <p class="mb-0 text-white" id="detailWordExample" style="white-space: pre-wrap; line-height: 1.6;"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="mt-auto py-3 border-top border-white-10" style="background: rgba(15, 15, 25, 0.8); backdrop-filter: blur(10px); border-top: 1px solid rgba(255, 255, 255, 0.05) !important;">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="text-white-50 small">
                &copy; @DateTime.Now.Year - <span class="fw-bold text-white">WordStation</span> - Her hakkı saklıdır.
            </div>
            <div>
                <span class="badge rounded-pill px-3 py-2" style="background: rgba(52, 211, 153, 0.1); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.2);">
                    <i class="bi bi-git me-1"></i> Version 1.0.7
                </span>
            </div>
        </div>
    </footer>

    <script>
        window.showWordDetail = function(en, tr, example) {
            document.getElementById('detailWordEn').textContent = en || '';
            document.getElementById('detailWordTr').textContent = tr || '';
            
            const exEl = document.getElementById('detailWordExample');
            if(example && example.trim() !== '') {
                exEl.textContent = example;
                exEl.parentElement.style.display = 'block';
            } else {
                exEl.parentElement.style.display = 'none';
            }
            
            const modalEl = document.getElementById('wordDetailModal');
            if(modalEl) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        };

        window.showWordDetailFromElement = function(element) {
            const en = element.getAttribute('data-en');
            const tr = element.getAttribute('data-tr');
            const example = element.getAttribute('data-example');
            showWordDetail(en, tr, example);
        };
    </script>

</body>
</html>
